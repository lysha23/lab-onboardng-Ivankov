# это корневой файл для всего проэкта
root=true

#Правка для всех фалов (*)
[*]
#использовать UTF-8
charset = utf-8
#Использовать пробелы для отступов
ident_style = space
#Размер отступа 4 пробела:
ident_sie = 4
#Тип переноса строки: LF
end_of_line = lf 
#удалять пробелы в конце строк
trim_trailing_whitespace = true
#Добавлять пустую строку в конце файла
insert_file_newline = true

#Особые правила для файлов разметки 
[*.{yml,yaml,json,html}]
ident_size = 2
